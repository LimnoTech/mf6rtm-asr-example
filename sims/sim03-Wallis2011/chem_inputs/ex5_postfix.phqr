KNOBS
  -iterations    200        ! Default: 100
  -convergence_tolerance 1e-12  ! Default: 1e-8 or 1e-12 when -high_precision true
  -tolerance     1e-16      ! Default: 1e-15 or smaller if double precision, typically 1e-12 to 1e-15
  -step_size     50.        ! Default: 100.
  -pe_step_size  7.         ! Default: 10. and should be smaller than step_size
  -diagonal_scale false     ! Default: false
  -debug_diffuse_layer false  ! Default: false
  -debug_inverse false      ! Default: false
  -debug_model false        ! Default: false
  -debug_prep false         ! Default: false
  -debug_set false          ! Default: false
  -logfile false            ! Default: false

SOLUTION_SPECIES
  H2O + 0.01e- = H2O-0.01
  log_k -9.0

  SELECTED_OUTPUT
    -reset         false
    -distance         false
    -file          out.dat

USER_PUNCH
    -headings time_d cell pH pe Alk Ca Mg Cl S(6) si_cc si_go Orgc_sed Calcite
    -start
    10 PUNCH TOTAL_TIME/86400
    20 punch cell_no
    30 punch -la("H+"), -la("e-"), alk, tot("Ca"), tot("Mg"), tot("Cl"), tot("S(6)")
    40 punch si("Calcite"), si("Goethite")
    50 punch tot("Orgc_sed") kin('Calcite')
    -end
END








