# 10 X 10 X 1 grid, same as the dis file

BEGIN OPTIONS
  LENGTH_UNITS FEET
END OPTIONS

BEGIN DIMENSIONS
  NLAY 5
  NCPL 957
  NVERT 1030
END DIMENSIONS

BEGIN GRIDDATA
  TOP
    CONSTANT 15.6
  BOTM LAYERED
    CONSTANT -145.0
    CONSTANT -562.0
    CONSTANT -796.0
    CONSTANT -1017.0
    CONSTANT -1445.0
END GRIDDATA

BEGIN VERTICES
  OPEN/CLOSE trans-temp_input/trans-temp.disv_VERTICES.txt
END VERTICES

BEGIN CELL2D
  OPEN/CLOSE trans-temp_input/trans-temp.disv_CELL2D.txt
END CELL2D
